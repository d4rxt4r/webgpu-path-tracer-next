{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["@webgpu/types", "vite/client", "node"],
    "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "skipLibCheck": true, "noEmit": true, "resolveJsonModule": true
  },
  "include": ["src", "tests", "playwright.config.ts"]
}
